# Ni obvezno — namestitev je v brskalniku. To je samo če hočeš okolje namesto obrazca.
ADMIN_PASSWORD=
# TV / bowling (opcijsko): raje Admin → TV / bowling ekran. Env je samo fallback.
DISPLAY_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=bowling_liga
# Alternativa: DATABASE_URL=mysql://user:pass@host:3306/bowling_liga
# Na Vercelu moraš te spremenljivke nastaviti v Project → Settings → Environment Variables
# (obrazec Namestitev tam ne shrani config.json). Brez MySQL so vabila samo v istem brskalniku.
PORT=3000
HOST=127.0.0.1
